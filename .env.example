# --- Runtime -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# --- Data stores ---------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgres://watchdog:watchdog@127.0.0.1:5432/watchdog

# --- Utility provider (EskomSePush) -------------------------------------
# provider: esp | fixture   (fixture = offline demo, no credits consumed)
ESP_PROVIDER=fixture
ESP_API_TOKEN=
ESP_API_BASE=https://developer.sepush.co.za/business/2.0
# Free tier is ~50 requests/day. Keep a hard cap so a bug cannot drain it.
ESP_DAILY_CREDIT_LIMIT=48
ESP_TIMEOUT_MS=10000

# Comma separated. First field is the ESP area id, second is the display name.
WATCH_ZONES=city-of-tshwane-tshwane-1:City of Tshwane,eskom-direct-city-of-johannesburg-1:Johannesburg
INGEST_INTERVAL_MS=900000
ALERT_ON_FIRST_SYNC=false

# --- Messaging -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET=
# Worker-level outbound ceiling. Telegram allows 30 msg/s; stay below it.
TELEGRAM_MAX_PER_SECOND=25

# --- POPIA / retention ---------------------------------------------------
DEDUP_TTL_SECONDS=86400
ALERT_HISTORY_RETENTION_DAYS=90
